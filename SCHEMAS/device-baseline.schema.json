{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kelronmos/SWI-Deviation-Device/schemas/device-baseline.schema.json",
  "title": "DEVICE_BASELINE",
  "type": "object",
  "required": [
    "device_id",
    "device_identity_binding",
    "admission_credential_id",
    "baseline_id",
    "baseline_version",
    "hardware_profile",
    "os_profile",
    "software_profile",
    "permission_profile",
    "connectivity_profile",
    "workflow_profile",
    "human_authority_profile",
    "evidence_requirements",
    "approved_by",
    "approved_at",
    "validity_period",
    "baseline_hash"
  ],
  "properties": {
    "device_id": { "type": "string" },
    "device_identity_binding": { "type": "string" },
    "admission_credential_id": { "type": "string" },
    "baseline_id": { "type": "string" },
    "baseline_version": { "type": "string" },
    "hardware_profile": { "type": "object" },
    "os_profile": { "type": "object" },
    "software_profile": { "type": "object" },
    "permission_profile": { "type": "object" },
    "connectivity_profile": { "type": "object" },
    "workflow_profile": { "type": "object" },
    "human_authority_profile": { "type": "object" },
    "evidence_requirements": { "type": "object" },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "validity_period": { "type": "string" },
    "baseline_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
